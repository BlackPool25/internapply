# =============================================================================
# InternApply — Environment Template
# Copy to .env and fill required values: cp .env.example .env
# See README.md#Configuration and internapply/config.py for defaults.
# =============================================================================

# --- Core — Docker secrets (required for compose) ---------------------------
# Postgres password. compose uses ${DB_PASSWORD:?error} — must be set.
# Example: openssl rand -hex 16
DB_PASSWORD=changeme

# --- Core — Infra (Postgres + Redis) ---------------------------------------
# Inside Docker use service name `postgres`, outside use 127.0.0.1.
# compose overrides this via DB_PASSWORD, so .env value is fallback for `python -m` outside Docker.
DATABASE_URL=postgresql+asyncpg://internapply:changeme@postgres:5432/internapply
# Local dev override (when running `internapply` CLI outside Docker, no compose):
# DATABASE_URL=postgresql+asyncpg://internapply:changeme@127.0.0.1:5432/internapply
REDIS_URL=redis://redis:6379/0
# Local dev override: REDIS_URL=redis://127.0.0.1:6379/0

# --- Optional — Tailor skill (user-run, not needed for discovery) -----------
# The `resume-tailor` skill is invoked locally by YOU via `opencode` (1 cached
# LLM call per JD, ~₹0.008). The discovery pipeline (discover→filter→save) is
# free and runs without any API key. Only set this if you personally run
# `/tailor` on your machine; Docker can stay empty.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# --- Hash / Dedup (must match DB) -----------------------------------------
HASH_SALT=internapply-v1
SIMHASH_THRESHOLD=3
VERIFIER_MIN_SCORE=80

# --- Discovery toggles (Tier0 ATS is config/boards.json, no env) ----------
HIRIST_ENABLED=true
UNSTOP_ENABLED=true
ARBEITNOW_ENABLED=true
REMOTIVE_ENABLED=true
THEMUSE_ENABLED=true
JOBICY_ENABLED=true
# Optional: TheMuse 3600/hr with key vs 500/hr anon (alias MUSE_API_KEY also accepted)
THEMUSE_API_KEY=
# MUSE_API_KEY=  # alias for THEMUSE_API_KEY
# Optional: LinkedIn 999 fallback via Node wreq-js JA3 sidecar
WREQ_SIDECAR_URL=
# Optional: Upwork Vollna RSS webhook (listener only, no scrape)
VOLLNA_RSS_URL=

# --- Networking -------------------------------------------------------------
# Free proxy for optional use (free-only v1 not routed; compose default is socks5://proxybroker:8888)
PROXY_URL=socks5://proxybroker:8888
# Frontend → API. Browser must use localhost, not service name `api`.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Preferences ------------------------------------------------------------
SEARCH_KEYWORDS='["python backend intern","java spring boot intern","backend engineer intern"]'
SEARCH_LOCATIONS='["Remote","Bangalore"]'
MIN_STIPEND_INR=5000
MAX_APPLICATIONS_PER_DAY=20
LOG_LEVEL=INFO
ENV=local

# --- Optional — Outreach (on-click only, never in batch) -------------------
HUNTER_API_KEY=
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_SECRET_PATH=
# For headless CI (daily-run): encrypted Gmail token injected via GitHub Secrets
# GMAIL_TOKEN_JSON=  # JSON string, encrypted at rest
# GMAIL_TOKEN_PASSPHRASE=  # to decrypt gmail_token.enc
# INTERNSHALA_SESSION_JSON=  # for Internshala browser session restore

# --- Legacy / Not used as primary -----------------------------------------
# SQLite kept only as CLI mirror/offline fallback; Postgres is primary.
DATABASE_PATH=data/internapply.db
# Dead actor, not wired (see internapply/config.py:NAUKRI_APIFY_TOKEN)
NAUKRI_APIFY_TOKEN=
