# === Required ===
OPENCODE_GO_API_KEY=           # Your OpenCode Go API key (get from opencode account settings)
OPENCODE_GO_MODEL=deepseek-v4-flash  # Model to use for LLM calls
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1  # API endpoint

# === Optional — Discovery ===
# No API keys needed for Internshala or Naukri (HTTP scraping)

# === Optional — Email Outreach ===
HUNTER_API_KEY=                # https://hunter.io — free tier: 50 searches/month
GMAIL_SENDER_EMAIL=            # Gmail address to send from
GMAIL_CLIENT_SECRET_PATH=      # Path to Gmail OAuth client_secret.json

# === Optional — Naukri Enrichment ===
NAUKRI_APIFY_TOKEN=            # Apify token if using enriched Naukri data (not required)

# === Preferences ===
SEARCH_KEYWORDS='["python backend intern","java spring boot intern","backend engineer intern"]'
SEARCH_LOCATIONS='["Remote","Bangalore"]'
MIN_STIPEND_INR=5000
MAX_APPLICATIONS_PER_DAY=20
LOG_LEVEL=INFO

# === Discovery — Hash/Dedup & Boards ===
HASH_SALT=internapply-v1
SIMHASH_THRESHOLD=3          # 1-10 Hamming distance
VERIFIER_MIN_SCORE=80        # 0-100
HIRIST_ENABLED=true
UNSTOP_ENABLED=true
ARBEITNOW_ENABLED=true
REMOTIVE_ENABLED=true
THEMUSE_ENABLED=true
JOBICY_ENABLED=true
WREQ_SIDECAR_URL=            # e.g. http://wreq:3000 for LinkedIn 999 fallback
VOLLNA_RSS_URL=              # e.g. https://www.vollna.com/rss/...

# === Infrastructure (Docker overrides via compose) ===
# Postgres 16 is primary; internapply/database.py keeps SQLite only as CLI mirror/offline fallback
DATABASE_URL=postgresql+asyncpg://internapply:changeme@postgres:5432/internapply
REDIS_URL=redis://redis:6379/0
ENV=local
