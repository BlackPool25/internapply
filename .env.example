# === Required ===
OPENCODE_GO_API_KEY=           # Your OpenCode Go API key (get from opencode account settings)
OPENCODE_GO_MODEL=deepseek-v4-flash  # Model to use for LLM calls (skill only)
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1  # API endpoint

# === Infra — Postgres + Redis + Hash/Skill ===
DATABASE_URL=postgresql+asyncpg://internapply:changeme@postgres:5432/internapply # service name postgres not localhost
REDIS_URL=redis://redis:6379/0
HASH_SALT=internapply-v1
SIMHASH_THRESHOLD=3 # Hamming distance threshold 1-10, 3 = near-dup on title+url
VERIFIER_MIN_SCORE=80 # WARN yellow 70-79 for first 30 JDs, hard 422 after
WREQ_SIDECAR_URL=http://wreq:3000 # optional Node wreq-js JA3 sidecar for LinkedIn 999 fallback
VOLLNA_RSS_URL= # optional for Upwork webhook
ARBEITNOW_ENABLED=true
HIRIST_ENABLED=true
UNSTOP_ENABLED=true
REMOTIVE_ENABLED=true
THEMUSE_ENABLED=true
JOBICY_ENABLED=true

# === Optional — Email Outreach (not in batch) ===
HUNTER_API_KEY=                # https://hunter.io — free tier: 50 searches/month, X/50 counter
GMAIL_SENDER_EMAIL=            # Gmail address to send from
GMAIL_CLIENT_SECRET_PATH=      # Path to Gmail OAuth client_secret.json

# === Optional — Discovery (tiered, ₹0/1k) ===
# Tier0: ATS boards probed ~100 (keyless, cursor updated_at|posted_date fallback) — no key
# Tier1: Hirist gladiator.hirist.tech free JSON + Unstop corrected + Internshala XHR — no key
# Tier3: Arbeitnow free / Remotive free capped / TheMuse 500/hr anon — paginated 20/page
# Tier2: JobSpy Naukri/Indeed — free scrape
# Tier3: LinkedIn overflow 999 breaker (wreq-js fallback optional)

# === Preferences ===
SEARCH_KEYWORDS='["python backend intern","java spring boot intern","backend engineer intern"]'
SEARCH_LOCATIONS='["Remote","Bangalore"]'
MIN_STIPEND_INR=5000
MAX_APPLICATIONS_PER_DAY=20
LOG_LEVEL=INFO
ENV=local

# === Legacy / Deprecated ===
# NAUKRI_APIFY_TOKEN — dead actor, not used
# SQLite DATABASE_PATH — now Postgres primary, SQLite only as CLI mirror/offline fallback
